generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CentroCosto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)

  // Permiso granular que activa el superadmin desde "Gestionar Centros de
  // Costo": si esta agencia puede agregar NUEVOS departamentos al catálogo
  // global (tipo 'secciones' en OpcionCatalogo), además de los que ya
  // existen. Por defecto NINGUNA agencia puede - se habilita agencia por
  // agencia (ver app/api/opciones/route.ts, que es quien de verdad lo hace
  // cumplir; esto es solo el dato).
  puedeCrearDepartamentos Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  productos Producto[]

  // NUEVO: usuarios que tienen este centro como centro ADICIONAL
  // (además de su centro principal, o en vez de él si son multi-centro)
  usuariosAdicionales UsuarioCentroCosto[]

  // NUEVO: proveedores/unidades personalizados propios de este centro (ver
  // OpcionCatalogo más abajo). Los departamentos/secciones NO viven aquí -
  // esos son globales, iguales para todos los centros.
  opcionesCatalogo OpcionCatalogo[]

  // NUEVO: alertas de costo/precio generadas por productos de este centro.
  historialAlertas HistorialAlerta[]

  // NUEVO: movimientos de valor de este centro (ver MovimientoInventario
  // más abajo).
  movimientosInventario MovimientoInventario[]

  @@index([nombre])
  @@index([activo])
}

model Usuario {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  nombre         String
  rol            String
  activo         Boolean      @default(true)
  centroCostoId  String?
  centroCosto    CentroCosto? @relation(fields: [centroCostoId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productosCreados  Producto[] @relation("ProductosCreadosPor")
  productosEditados Producto[] @relation("ProductosEditadosPor")

  // NUEVO: centros de costo adicionales (más allá de centroCostoId).
  // Un Admin/Asesor multi-centro tiene su centro "principal" en
  // centroCostoId (como siempre) y los demás aquí.
  centrosCostoAdicionales UsuarioCentroCosto[]

  // NUEVO: alertas de costo/precio - las que este usuario generó al crear o
  // editar un producto, y las que revisó/resolvió desde el Historial.
  alertasGeneradas HistorialAlerta[] @relation("AlertaGeneradaPor")
  alertasResueltas HistorialAlerta[] @relation("AlertaResueltaPor")

  // NUEVO: movimientos de valor que este usuario registró al editar un
  // producto, y los que marcó como revisados.
  movimientosRegistrados MovimientoInventario[] @relation("MovimientoRegistradoPor")
  movimientosRevisados   MovimientoInventario[] @relation("MovimientoRevisadoPor")

  @@index([email])
  @@index([activo])
  @@index([centroCostoId])
}

model Producto {
  id             String       @id @default(cuid())
  proveedor      String
  referencia     String
  producto       String
  cantidad       Float        // Float para aceptar decimales

  // NUEVO: de la "cantidad" total, cuánto está en mal estado (detectado en
  // el conteo físico). Nunca debería superar "cantidad" - se valida al
  // guardar. Sigue sumando al valor total del inventario igual que antes;
  // solo permite mostrar el desglose bueno/dañado en las estadísticas (ver
  // app/api/productos/estadisticas/route.ts).
  cantidadDanada Float        @default(0)

  unidades       String
  costo          String
  costoReal      Int          @default(0)
  precioVenta    String
  codigo         String
  codigoBarras   String       @unique
  embalaje       String?      // Campo opcional
  seccion        String?      // Sección del producto - opcional en BD (productos existentes no tienen valor), obligatoria en el formulario para productos nuevos

  // Estado "histórico" del producto (dado de baja manual). Se conserva en la
  // base de datos mas ya no se usa como criterio principal para los totales
  // de inventario - ver "anioInventario" abajo.
  activo         Boolean      @default(true)

  // Año del último inventario en el que se confirmó este producto. Todos los
  // productos existentes arrancan en 2025 (no se pierde ni se borra nada).
  // Se actualiza automáticamente al año actual cuando alguien edita la
  // cantidad de un producto (ver app/api/productos/[id]/route.ts), y se
  // puede forzar manualmente vía app/api/productos/[id]/estado/route.ts.
  // Solo los productos con anioInventario === año actual se cuentan en los
  // totales de inventario (proveedor/departamento) - así los productos que
  // no se vuelven a contar en el nuevo inventario físico (por dañados,
  // agotados, etc.) dejan de sumar sin necesidad de eliminarlos.
  anioInventario Int          @default(2025)

  // Marca cuándo este producto pasó de cantidad 0 a una cantidad positiva
  // por última vez (ver app/api/productos/[id]/route.ts) - es el momento en
  // que "se cuenta" en el inventario físico, a diferencia de un simple
  // ajuste de stock (sumar/restar) sobre un producto que ya tenía cantidad.
  // Null = nunca ha tenido esa transición. Sirve para (1) ordenar la tabla
  // poniendo esos productos primero, del más reciente al más antiguo, y
  // (2) mostrar la etiqueta "HOY" mientras siga siendo el mismo día (se
  // calcula al vuelo comparando con la fecha actual - no hay que reiniciar
  // nada manualmente).
  ultimoConteoAt DateTime?

  // Centro de Costo - OPCIONAL al inicio para la migración
  centroCostoId  String?
  centroCosto    CentroCosto? @relation(fields: [centroCostoId], references: [id])

  // Tracking de usuarios
  creadoPorId    String?
  creadoPor      Usuario?     @relation("ProductosCreadosPor", fields: [creadoPorId], references: [id])
  editadoPorId   String?
  editadoPor     Usuario?     @relation("ProductosEditadosPor", fields: [editadoPorId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // NUEVO: alertas de costo/precio generadas por este producto (ver
  // HistorialAlerta más abajo).
  historialAlertas HistorialAlerta[]

  // NUEVO: movimientos de valor (costo/cantidad/dañado) de este producto -
  // ver MovimientoInventario más abajo.
  movimientosInventario MovimientoInventario[]

  @@index([proveedor])
  @@index([producto])
  @@index([creadoPorId])
  @@index([referencia])
  @@index([centroCostoId])  // Importante para filtrado rápido
  @@index([seccion])
  @@index([activo])
  @@index([anioInventario])
  @@index([centroCostoId, anioInventario]) // La combinación que más se consulta
  @@index([ultimoConteoAt]) // Orden "contados hoy primero" (superadmin, sin centro)
  @@index([centroCostoId, ultimoConteoAt]) // Mismo orden pero filtrado por centro de costo (admin/asesor)
}

// Alertas: se inserta una fila SOLO cuando el precio de venta queda por
// debajo del costo - en una edición/creación normal no se escribe nada
// aquí. Tabla puramente aditiva: no modifica Producto ni Usuario, y solo
// la consulta el módulo Alertas (admin/superadmin/asesor).
model HistorialAlerta {
  id       String @id @default(cuid())
  tipo     String // 'PRECIO_MENOR_COSTO'

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  // Copiado del producto al momento de la alerta (igual que centroCostoId en
  // Producto) para que el Historial filtre por sucursal sin tener que unir
  // con Producto cada vez.
  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation("AlertaGeneradaPor", fields: [usuarioId], references: [id])

  // Snapshot de los valores en el momento de la alerta (no se vuelven a leer
  // de Producto después, porque ese valor puede seguir cambiando).
  // "costoAnterior" queda sin usar (era de un tipo de alerta que ya no
  // existe) - se deja la columna en vez de migrar para no tocar la tabla
  // sin necesidad.
  costoAnterior    Int?
  costoNuevo       Int
  precioVentaNuevo Float?

  resuelto      Boolean   @default(false)
  resueltoPorId String?
  resueltoPor   Usuario?  @relation("AlertaResueltaPor", fields: [resueltoPorId], references: [id])
  resueltoAt    DateTime?

  createdAt DateTime @default(now())

  @@index([centroCostoId, resuelto])
  @@index([productoId])
  @@index([tipo])
  @@index([createdAt])
}

// Registro pasivo de cada cambio de costo (suba o baje) - a diferencia de
// HistorialAlerta, esto NO es una alerta que requiera revisión, es
// simplemente la justificación de por qué el Gran Total subió o bajó, para
// que el administrador pueda explicárselo a contabilidad. Se inserta una
// fila SOLO cuando el costo real de verdad cambió (ver
// app/api/productos/[id]/route.ts) - cantidad y mercancía dañada no
// generan movimiento acá, a pedido explícito. Tabla puramente aditiva.
model MovimientoInventario {
  id   String @id @default(cuid())
  tipo String // 'COSTO'

  // La relación es SetNull, NO Cascade: si el producto se elimina más
  // adelante, este movimiento (que es el registro contable de algo que
  // YA pasó) se queda - solo pierde el link. Por eso también se copian
  // estos datos del producto al momento del movimiento, para que la fila
  // siga siendo legible aunque el producto ya no exista.
  productoId         String?
  producto           Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  productoNombre     String
  productoReferencia String
  proveedor          String
  seccion            String?

  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation("MovimientoRegistradoPor", fields: [usuarioId], references: [id])

  // Costo real antes y después de este movimiento.
  valorAnterior Float
  valorNuevo    Float

  // Cuánto cambió el Gran Total por este cambio de costo específico
  // (puede ser negativo). Si el producto no tiene cantidad en inventario
  // en ese momento, queda en 0 - el cambio de costo no impacta nada en
  // plata, pero el movimiento se registra igual para que quede visible.
  deltaValor Float

  // El administrador puede marcar que ya revisó este cambio de costo -
  // igual patrón que HistorialAlerta.resuelto, pero acá no hay nada que
  // "corregir" (no se autorresuelve solo); es solo una confirmación manual
  // de que lo vio y está bien.
  resuelto      Boolean   @default(false)
  resueltoPorId String?
  resueltoPor   Usuario?  @relation("MovimientoRevisadoPor", fields: [resueltoPorId], references: [id])
  resueltoAt    DateTime?

  createdAt DateTime @default(now())

  @@index([centroCostoId, createdAt])
  @@index([centroCostoId, resuelto])
  @@index([productoId])
  @@index([tipo])
}

// Catálogo de opciones personalizadas para los desplegables del formulario
// de productos (proveedor, unidades, departamento/sección). Antes vivían en
// localStorage - una copia distinta por navegador, sin compartir entre
// usuarios.
//
// - 'proveedores' y 'unidades': propios de CADA centro de costo (un centro
//   no ve ni puede tocar los del otro) - centroCostoId obligatorio.
// - 'secciones' (departamentos): catálogo GLOBAL, igual para todos los
//   centros - centroCostoId siempre NULL.
//
// La regla de "no repetido" (un mismo valor no se repite dos veces para el
// mismo tipo+centro, o dos veces en el catálogo global de secciones) se
// hace cumplir con dos índices únicos PARCIALES creados a mano en la
// migración (Prisma no soporta índices únicos condicionales en el schema),
// por eso no hay un @@unique declarado aquí - ver el archivo migration.sql
// correspondiente para el detalle.
model OpcionCatalogo {
  id            String       @id @default(cuid())
  tipo          String       // 'proveedores' | 'unidades' | 'secciones'
  valor         String
  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([tipo, centroCostoId])
}

// NUEVO modelo - tabla puente para la relación muchos-a-muchos entre
// Usuario y CentroCosto. No modifica ninguna tabla existente; es
// puramente aditiva (CREATE TABLE en la migración).
model UsuarioCentroCosto {
  id            String      @id @default(cuid())
  usuarioId     String
  centroCostoId String
  createdAt     DateTime    @default(now())

  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, centroCostoId])
  @@index([usuarioId])
  @@index([centroCostoId])
}
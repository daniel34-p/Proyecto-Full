generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CentroCosto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios  Usuario[]
  productos Producto[]

  // NUEVO: usuarios que tienen este centro como centro ADICIONAL
  // (además de su centro principal, o en vez de él si son multi-centro)
  usuariosAdicionales UsuarioCentroCosto[]

  // NUEVO: proveedores/unidades personalizados propios de este centro (ver
  // OpcionCatalogo más abajo). Los departamentos/secciones NO viven aquí -
  // esos son globales, iguales para todos los centros.
  opcionesCatalogo OpcionCatalogo[]

  @@index([nombre])
  @@index([activo])
}

model Usuario {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  nombre         String
  rol            String
  activo         Boolean      @default(true)
  centroCostoId  String?
  centroCosto    CentroCosto? @relation(fields: [centroCostoId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productosCreados  Producto[] @relation("ProductosCreadosPor")
  productosEditados Producto[] @relation("ProductosEditadosPor")

  // NUEVO: centros de costo adicionales (más allá de centroCostoId).
  // Un Admin/Asesor multi-centro tiene su centro "principal" en
  // centroCostoId (como siempre) y los demás aquí.
  centrosCostoAdicionales UsuarioCentroCosto[]

  @@index([email])
  @@index([activo])
  @@index([centroCostoId])
}

model Producto {
  id             String       @id @default(cuid())
  proveedor      String
  referencia     String
  producto       String
  cantidad       Float        // Float para aceptar decimales
  unidades       String
  costo          String
  costoReal      Int          @default(0)
  precioVenta    String
  codigo         String
  codigoBarras   String       @unique
  embalaje       String?      // Campo opcional
  seccion        String?      // Sección del producto - opcional en BD (productos existentes no tienen valor), obligatoria en el formulario para productos nuevos

  // Estado "histórico" del producto (dado de baja manual). Se conserva en la
  // base de datos mas ya no se usa como criterio principal para los totales
  // de inventario - ver "anioInventario" abajo.
  activo         Boolean      @default(true)

  // Año del último inventario en el que se confirmó este producto. Todos los
  // productos existentes arrancan en 2025 (no se pierde ni se borra nada).
  // Se actualiza automáticamente al año actual cuando alguien edita la
  // cantidad de un producto (ver app/api/productos/[id]/route.ts), y se
  // puede forzar manualmente vía app/api/productos/[id]/estado/route.ts.
  // Solo los productos con anioInventario === año actual se cuentan en los
  // totales de inventario (proveedor/departamento) - así los productos que
  // no se vuelven a contar en el nuevo inventario físico (por dañados,
  // agotados, etc.) dejan de sumar sin necesidad de eliminarlos.
  anioInventario Int          @default(2025)

  // Centro de Costo - OPCIONAL al inicio para la migración
  centroCostoId  String?
  centroCosto    CentroCosto? @relation(fields: [centroCostoId], references: [id])

  // Tracking de usuarios
  creadoPorId    String?
  creadoPor      Usuario?     @relation("ProductosCreadosPor", fields: [creadoPorId], references: [id])
  editadoPorId   String?
  editadoPor     Usuario?     @relation("ProductosEditadosPor", fields: [editadoPorId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([proveedor])
  @@index([producto])
  @@index([creadoPorId])
  @@index([referencia])
  @@index([centroCostoId])  // Importante para filtrado rápido
  @@index([seccion])
  @@index([activo])
  @@index([anioInventario])
  @@index([centroCostoId, anioInventario]) // La combinación que más se consulta
}
// Catálogo de opciones personalizadas para los desplegables del formulario
// de productos (proveedor, unidades, departamento/sección). Antes vivían en
// localStorage - una copia distinta por navegador, sin compartir entre
// usuarios.
//
// - 'proveedores' y 'unidades': propios de CADA centro de costo (un centro
//   no ve ni puede tocar los del otro) - centroCostoId obligatorio.
// - 'secciones' (departamentos): catálogo GLOBAL, igual para todos los
//   centros - centroCostoId siempre NULL.
//
// La regla de "no repetido" (un mismo valor no se repite dos veces para el
// mismo tipo+centro, o dos veces en el catálogo global de secciones) se
// hace cumplir con dos índices únicos PARCIALES creados a mano en la
// migración (Prisma no soporta índices únicos condicionales en el schema),
// por eso no hay un @@unique declarado aquí - ver el archivo migration.sql
// correspondiente para el detalle.
model OpcionCatalogo {
  id            String       @id @default(cuid())
  tipo          String       // 'proveedores' | 'unidades' | 'secciones'
  valor         String
  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([tipo, centroCostoId])
}

// NUEVO modelo - tabla puente para la relación muchos-a-muchos entre
// Usuario y CentroCosto. No modifica ninguna tabla existente; es
// puramente aditiva (CREATE TABLE en la migración).
model UsuarioCentroCosto {
  id            String      @id @default(cuid())
  usuarioId     String
  centroCostoId String
  createdAt     DateTime    @default(now())

  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  centroCosto   CentroCosto @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, centroCostoId])
  @@index([usuarioId])
  @@index([centroCostoId])
}